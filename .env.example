# Live pricing is optional. With no keys the app runs on bundled demo data.
# Copy to `.env` and restart the dev server.

# Accounts + cloud-synced saved trips/bookings — https://supabase.com (free tier)
# Project Settings > API. The anon key is safe to ship; row-level security protects data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public URL used for auth email links (password reset, etc). Required for the native
# app and any deployment where window.location.origin isn't your real public domain.
# Must also be added to Supabase Authentication > URL Configuration > Redirect URLs.
VITE_SITE_URL=https://weekndrr.com

# Set true only after deploying supabase/functions/travel-pricing.
VITE_LIVE_PRICING=false

# Provider secrets belong in Supabase Edge Function secrets, never in VITE_ variables:
# supabase secrets set AMADEUS_CLIENT_ID=... AMADEUS_CLIENT_SECRET=... RAPIDAPI_KEY=...
